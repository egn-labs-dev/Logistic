# SECURITY WARNING: На продакшені обов'язково змініть ці значення на випадкові довгі строки!
# Використовуйте `openssl rand -hex 32` для генерації JWT_SECRET_KEY
JWT_SECRET_KEY=replace_me_with_a_long_random_string_in_production_e9f8c7b6a5
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# База даних (Production)
# Переконайтесь, що пароль збігається в docker-compose.prod.yml
DB_PASSWORD=your_secure_db_password_here
DATABASE_URL=postgresql+asyncpg://log_admin:${DB_PASSWORD}@db:5432/logistics_secure_db

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Налаштування CORS
ALLOWED_ORIGINS=https://app.zt-dispatch.com,https://www.zt-dispatch.com

# Налаштування інфраструктури
PORT=8000
ENVIRONMENT=production
